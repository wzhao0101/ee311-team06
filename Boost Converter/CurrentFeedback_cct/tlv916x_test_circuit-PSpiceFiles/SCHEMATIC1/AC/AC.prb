[MEASUREMENTS]
AC 0 YatFirstX(DB(V(VOUT)/(V(VIN)-V(VOUT))))
AC 0 XatNthY(DB(V(VOUT)/(V(VIN)-V(VOUT))),60,1) * 1k
AC 0 ZeroCross(DB(V(VOUT)/(V(VIN)-V(VOUT))))
AC 0 PhaseMargin(DB(V(VOUT)/(V(VIN)-V(VOUT))),P(V(VOUT)/(V(VIN)-V(VOUT))))
AC 0 GainMargin(P(V(VOUT)/(V(VIN)-V(VOUT))),DB(V(VOUT)/(V(VIN)-V(VOUT))))
[DISPLAYS]
BEGIN DISPLAY LAST SESSION
ANALYSIS AC_SWEEP
SYMBOL ALWAYS
TRACECOLORSCHEME NORMAL
BEGIN ANAPLOT 1
ACTIVE
XBASE
BEGIN XAXIS
XAXISUSERNAME 0 (null)
TEXT Frequency
RANGEFLAG AUTO
TYPE LOG
UNIT H
BEGIN GRIDS
AUTOMATIC
MAJORNUMBERS
MAJORSTYLE LINES
MAJORPATTERN SOLID
MINORSTYLE LINES
MINORPATTERN DOT
END GRIDS
END XAXIS
BEGIN YAXIS 1
YAXISSIDE LEFT
ACTIVE
RANGEFLAG AUTO
TYPE LINEAR
UNIT V
BEGIN GRIDS
AUTOMATIC
MAJORNUMBERS
MAJORSTYLE LINES
MAJORPATTERN SOLID
MINORSTYLE LINES
MINORPATTERN DOT
END GRIDS
BEGIN TRACE V(VOUT)
MARKERID 3
TRACEADDEXT
END TRACE V(VOUT)
BEGIN TRACE V(VIN,VOUT)
MARKERID 4
TRACEADDEXT
END TRACE V(VIN,VOUT)
END YAXIS 1
END ANAPLOT 1
BEGIN MEASUREMENTS
SIZE 122
MEASNAMECOLWIDTH 348
BEGIN MEASUREMENT 1
NAME YatFirstX(DB(V(VOUT)/(V(VIN)-V(VOUT))))
EVALUATE 1
END MEASUREMENT 1
BEGIN MEASUREMENT 2
NAME XatNthY(DB(V(VOUT)/(V(VIN)-V(VOS))),60,1) * 1k
EVALUATE 1
END MEASUREMENT 2
BEGIN MEASUREMENT 3
NAME ZeroCross(DB(V(VOUT)/(V(VIN)-V(VOS))))
EVALUATE 1
END MEASUREMENT 3
BEGIN MEASUREMENT 4
NAME PhaseMargin(DB(V(VOUT)/(V(VIN)-V(VOS))),P(V(VOUT)/(V(VIN)-V(VOS))))
EVALUATE 1
END MEASUREMENT 4
BEGIN MEASUREMENT 5
NAME GainMargin(P(V(VOUT)/(V(VIN)-V(VOS))),DB(V(VOUT)/(V(VIN)-V(VOS))))
EVALUATE 1
END MEASUREMENT 5
END MEASUREMENTS
END DISPLAY LAST SESSION
BEGIN DISPLAY LAST DISPLAY
ANALYSIS AC_SWEEP
SYMBOL ALWAYS
TRACECOLORSCHEME NORMAL
BEGIN ANAPLOT 1
ACTIVE
XBASE
BEGIN XAXIS
XAXISUSERNAME 0 (null)
TEXT Frequency
RANGEFLAG AUTO
TYPE LOG
UNIT H
BEGIN GRIDS
AUTOMATIC
MAJORNUMBERS
MAJORSTYLE LINES
MAJORPATTERN SOLID
MINORSTYLE LINES
MINORPATTERN DOT
END GRIDS
END XAXIS
BEGIN YAXIS 1
YAXISSIDE LEFT
ACTIVE
RANGEFLAG NORANGE
TYPE LINEAR
UNIT  
END YAXIS 1
END ANAPLOT 1
END DISPLAY LAST DISPLAY
